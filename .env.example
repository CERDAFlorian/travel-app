# Ces deux variables décrivent la base de DÉVELOPPEMENT.
#
# La production vit dans un SECOND projet Supabase, dont les valeurs sont dans
# les secrets GitHub du dépôt — jamais ici, jamais dans un fichier commité.
# Voir supabase/README.md, « Deux bases ».
VITE_SUPABASE_URL='https://votre-projet-dev.supabase.co'
VITE_SUPABASE_ANON_KEY='votre-cle-publishable'

# Carte Google (L10). La clé « navigateur » part dans le bundle : ce sont ses
# restrictions dans Google Cloud qui la protègent — acceptée seulement depuis
# travel.floriancerda.fr et localhost:5173 / 4173, et pour deux API (Maps
# JavaScript API, Places API (New)). Le Map ID porte le style de la carte
# (design/carte-google-style.json). Sans ces deux valeurs, la carte affiche
# « clé non configurée » et le reste de l'app fonctionne.
VITE_GOOGLE_MAPS_KEY='votre-cle-navigateur'
VITE_GOOGLE_MAP_ID='votre-map-id'

# Clé « scripts » : Places API (New) seulement, sans restriction d'adresse, pour
# les scripts lancés depuis le poste (test F0, migration de l'existant). SANS
# préfixe VITE_ : elle ne doit jamais partir dans le bundle.
GOOGLE_MAPS_TEST_KEY='votre-cle-scripts'
